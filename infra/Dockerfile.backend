# Backend image: API + worker share this. ffmpeg baked in for the render worker.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml /app/backend/pyproject.toml
COPY backend/recut /app/backend/recut
COPY shared /app/shared
COPY assets /app/assets

RUN pip install --no-cache-dir -e "/app/backend[models]"

ENV RECUT_WORK_DIR=/tmp/recut PYTHONUNBUFFERED=1
WORKDIR /app/backend
EXPOSE 8000
CMD ["recut-api"]
