# ─────────────────────────────────────────────────────────────────────────────
# Recut config. Copy to .env and fill in. Local-first: defaults below run fully on
# your machine (Postgres + MinIO via docker-compose, stub models, no keys). Flip
# RECUT_MODEL_BACKEND=qwen and add the DashScope key to go live on Model Studio.
# Deploying to Alibaba is changing these values, not the code.
# ─────────────────────────────────────────────────────────────────────────────

# --- Model layer ---------------------------------------------------------------
# stub = high-fidelity deterministic local stubs (no key, offline demo).
# qwen = real DashScope / Alibaba Model Studio.
RECUT_MODEL_BACKEND=stub

# DashScope / Model Studio API key (the ONE key you paste last). Get it from the
# Alibaba Cloud Model Studio console. Leave blank while RECUT_MODEL_BACKEND=stub.
RECUT_DASHSCOPE_API_KEY=

# DashScope endpoint. Leave blank for the SDK default (China). International accounts
# (Singapore, etc.) MUST set this:
# RECUT_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
RECUT_DASHSCOPE_BASE_URL=

# Model IDs (confirm exact IDs in the Model Studio console for your region).
RECUT_QWEN_VL_MODEL=qwen-vl-max          # shot/scene/on-screen-text analysis
RECUT_QWEN_TEXT_MODEL=qwen-max           # recipe, co-writing, captions, cover copy
RECUT_ASR_MODEL=paraformer-v2            # transcription (ASR)
RECUT_WAN_MODEL=wanx2.1-t2v-turbo        # generated b-roll
RECUT_QWEN_IMAGE_MODEL=wanx2.1-t2i-turbo # text-card backgrounds
RECUT_COSYVOICE_MODEL=cosyvoice-v1       # voiceover (+ consent-gated cloning, post-v1)

# --- Storage (S3-compatible: MinIO locally, Alibaba OSS in prod) ---------------
RECUT_S3_ENDPOINT=http://localhost:9000
RECUT_S3_REGION=us-east-1
RECUT_S3_ACCESS_KEY=minioadmin
RECUT_S3_SECRET_KEY=minioadmin
RECUT_S3_BUCKET=recut
RECUT_S3_PUBLIC_BASE=http://localhost:9000/recut
# Set to "local" to use the filesystem instead of MinIO (no S3 needed).
RECUT_STORAGE_BACKEND=

# --- Database (Postgres locally and in prod; RDS on Alibaba) -------------------
RECUT_DATABASE_URL=postgresql+psycopg://recut:recut@localhost:5432/recut

# --- Token / cost discipline ---------------------------------------------------
RECUT_PROJECT_TOKEN_CAP=200000           # hard ceiling on generation tokens / project

# --- Media / render ------------------------------------------------------------
RECUT_FFMPEG_BIN=ffmpeg
RECUT_FFPROBE_BIN=ffprobe
RECUT_WORK_DIR=/tmp/recut

# --- Frontend ------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
