# Recut environment. Copy to .env.local and fill in for live mode.

# replay (default, zero network, resolves from fixtures/) | live (real API calls)
RECUT_MODE=replay

# Hard spend cap in USD. Required when RECUT_MODE=live. The submitter refuses
# to submit once cumulative spend would cross this. There is no override.
RECUT_BUDGET_USD=8

# Alibaba Model Studio / DashScope (ap-southeast-1). Only read in live mode.
RECUT_DASHSCOPE_API_KEY=
RECUT_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com

# Read-only showcase projects (comma-separated ids). The demo films: judges can
# open and explore them, but generation is refused (a popup points them to make
# their own project) and no edit persists. Set this on the public deployment.
# RECUT_SHOWCASE_IDS=84a37d3f,e41ccaa2

# --- Public judge deployment (Alibaba ECS) ---
# Let judges generate for real, capped to a shared budget. Set:
#   RECUT_MODE=live
#   RECUT_BUDGET_USD=5           # hard cap across ALL judges; governor refuses past it
#   RECUT_DASHSCOPE_API_KEY=...  # a key scoped/limited on the Alibaba side too, ideally
#   RECUT_SHOWCASE_IDS=84a37d3f,e41ccaa2
# Once $5 of spend is recorded, every generate returns a friendly "budget used up" message.
